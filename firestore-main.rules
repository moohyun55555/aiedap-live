rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPresenter() {
      return request.auth != null && request.auth.token.email == 'presenter@aiedap-live.kr';
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // 메인 사이트: 슬라이드 위치 (발표자만 바꿀 수 있음)
    match /live/state {
      allow read: if true;
      allow write: if isPresenter()
        && request.resource.data.keys().hasOnly(['slide', 'recall', 'lock', 'chatPaused']);

      // 실시간 채팅
      match /chat/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'host', 'at'])
          && str(request.resource.data.name, 20) && request.resource.data.name.size() > 0
          && str(request.resource.data.text, 300) && request.resource.data.text.size() > 0
          && request.resource.data.at == request.time
          && (request.resource.data.host == false || (request.resource.data.host == true && isPresenter()))
          && (isPresenter() || !exists(/databases/$(database)/documents/live/state) || !get(/databases/$(database)/documents/live/state).data.get('chatPaused', false));
        allow delete: if isPresenter();
      }
    }

  }
}
